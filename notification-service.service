[Unit]
Description=Trading Bot Notification Service
After=network.target

# Page the operator if this unit fails (issue #25). Deliberately independent of
# the notifier itself: alerts go straight over SMTP via services/notify_alert.py,
# so this service being down cannot mute its own failure report.
OnFailure=service-failure-notifier@%n.service

[Service]
Type=simple
User=i030983
WorkingDirectory=/home/i030983/tradingbots
Environment="PYTHONUNBUFFERED=1"
Environment="GOOGLE_CLOUD_PROJECT=project-dfe26779-9849-4c97-9b6"
Environment="GCP_PROJECT=project-dfe26779-9849-4c97-9b6"
EnvironmentFile=/home/i030983/.trading_profile
ExecStart=/home/i030983/venv311/bin/python3 -m notification_service.main
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=notification-service

[Install]
WantedBy=multi-user.target