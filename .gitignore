# Service files should be committed
# Only gitignore temporary files

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs (should not be in repo)
*.log
*.out

# Backup files
*.bak
*.backup

# Python cache & test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

