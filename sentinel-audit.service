[Unit]
Description=In-Flight Thesis Sentinel Pre-Market Audit
Documentation=https://github.com/PowerStreamCoder/tradingbot-bots/issues/214
After=network-online.target
Wants=network-online.target
Requires=network-online.target

# One-shot: a failed audit must page the operator rather than fail silently.
OnFailure=service-failure-notifier@%n.service

[Service]
Type=oneshot
User=i030983
Group=i030983
WorkingDirectory=/home/i030983/tradingbots

# The token is provisioned out-of-band (Secret Manager -> chmod 600 file on the
# VM); it is never committed to this repository.
EnvironmentFile=/home/i030983/.sentinel_audit
Environment="SENTINEL_AUDIT_URL=https://trading-dashboard-w2n5czslna-uc.a.run.app/api/stock-picks/sentinel/audit/internal"

# The audit runs on Cloud Run (it needs pandas/yfinance/stockpicker), so the VM
# only triggers the token-guarded endpoint. bash -c is required because systemd
# does not expand ${VAR} in ExecStart directly.
ExecStart=/bin/bash -c 'curl --fail --silent --show-error --max-time 120 -X POST -H "X-Sentinel-Token: ${SENTINEL_AUDIT_TOKEN}" "${SENTINEL_AUDIT_URL}"'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-audit

# One audit per trading day; no restart, bounded resources.
TimeoutStartSec=150s
MemoryMax=64M
CPUQuota=10%
Restart=no

[Install]
WantedBy=multi-user.target
