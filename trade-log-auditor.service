[Unit]
Description=Trade Log Auditor (offline post-close audit)
Documentation=https://github.com/PowerStreamCoder/tradingbot-documentation
After=network-online.target
Wants=network-online.target
Requires=network-online.target

# The auditor reads the previous session's trade log, so it must not race the bots
# writing today's records. Starting after the stop timer guarantees the day's
# records are final.
After=trading-bot-manager-stop.timer
Wants=trading-bot-manager-stop.timer

# Page the operator if this unit fails (issue #25). Findings themselves are
# already emailed by the auditor's own notify stage (--send-alerts), so the alert
# here is about the job breaking, not about what it found. SuccessExitStatus in
# [Service] keeps exit 3 (INCONCLUSIVE, e.g. a session with no trades) from
# marking the unit failed; exit 1 (critical findings OR an unhandled crash) and
# exit 2 (usage/config error) still fire the alert.
OnFailure=service-failure-notifier@%n.service

[Service]
Type=oneshot
User=i030983
Group=i030983

# Exit 3 is INCONCLUSIVE: a legitimate verdict, not a failure. Declared here --
# SuccessExitStatus is a [Service] directive, and systemd silently ignores it in
# [Unit] (caught by `systemd-analyze verify`).
SuccessExitStatus=0 3

# The auditor code lives in the tradingbot-tools repository and is deployed to this
# path by that repo's own deploy-tools.yml (23:45 ET nightly, plus manual dispatch).
# The tradingbot-services workflow ships only .service/.timer files, so it does not
# deliver the code itself -- but it is scheduled at 23:55 ET, 10 minutes after the
# tools deploy, so the package is present and the timer can be enabled the same
# night. Check prerequisites in ExecStartPre; the run aborts with an actionable
# message rather than a bare "No module named auditor".
ExecStartPre=/usr/bin/test -d /home/i030983/tradingbot-tools/auditor
ExecStartPre=/usr/bin/test -d /home/i030983/tradingbots/trading

WorkingDirectory=/home/i030983/tradingbot-tools

Environment=BOTS_DIR=/home/i030983/tradingbots
Environment=PYTHONPATH=/home/i030983/tradingbot-tools

# Audit the previous session, publish proposals to learning_candidates for human
# review, and page the operator for new critical/high findings. The auditor is
# read-only against live trading state; its only writes are the audit_* collections,
# its own memory/report files, pending_review learning candidates, and notifications.
#
# Mutual exclusion: the auditor enforces single-instance itself, taking an
# exclusive, non-blocking flock on /tmp/trade_log_auditor.lock
# (auditor/cli.py::_acquire_lock) and failing fast when another run -- e.g. a
# documented manual `python3 -m auditor` -- is already reconciling memory.
#
# Do NOT also wrap ExecStart in `flock`: the outer flock holds the lock for the
# whole run while the auditor asks for that same lock through its own file
# descriptor, so every run aborts with "Another auditor instance is already
# running" (issue #98).
#
# `--date latest` resolves to the most recent session before today (Monday audits
# Friday; weekends are skipped), so this Mon-Fri timer never targets a closed day.
# The resolved ISO date - not the keyword - keys the auditor's memory lifecycle,
# alerts and report filenames (tradingbot-tools#102).
ExecStart=/usr/bin/python3 -m auditor --date latest --publish-proposals --send-alerts

StandardOutput=journal
StandardError=journal
SyslogIdentifier=trade-log-auditor

# Resource limits: the audit is a batch job over one session's records.
TimeoutStartSec=600s
MemoryMax=1G
CPUQuota=50%

# One-shot: a failed audit is a real signal, not something to retry blindly.
# The timer runs again the next trading day.
Restart=no

[Install]
WantedBy=multi-user.target
