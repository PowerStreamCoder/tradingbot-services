[Unit]
Description=Nightly Learning Analysis
Documentation=https://github.com/PowerStreamCoder/tradingbot-documentation
After=network-online.target
Wants=network-online.target
Requires=network-online.target

# Page the operator if this unit fails (issue #25). The nightly learning pass is a
# one-shot; a silent failure used to be invisible until someone read the journal.
OnFailure=service-failure-notifier@%n.service

[Service]
Type=oneshot
User=i030983
Group=i030983
WorkingDirectory=/home/i030983/tradingbots
Environment="GOOGLE_CLOUD_PROJECT=project-dfe26779-9849-4c97-9b6"
Environment="GCP_PROJECT=project-dfe26779-9849-4c97-9b6"

# Execute analysis script.
# --run-async-backtests spawns the detached backtest-simulation worker
# (scripts/run_async_backtests.py) AFTER findings are saved, so queued
# learning candidates get their ΔSharpe/ΔPnL deltas computed and the
# clamped_micro non-regression gate can actually fire. Without this flag the
# engine sets backtest_status="queued" but nothing ever dequeues it (#269).
# The worker is detached (start_new_session) and does not count against this
# unit's TimeoutStartSec=300s oneshot budget.
ExecStart=/usr/bin/python3 /home/i030983/tradingbots/scripts/run_learning_analysis.py --run-async-backtests

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=learning-analysis

# Resource limits (analysis typically uses ~200MB, <10% CPU)
# These limits prevent runaway bugs from impacting bots
TimeoutStartSec=300s
MemoryMax=1G
CPUQuota=50%

# Restart policy (don't restart - it's a one-shot)
Restart=no

[Install]
WantedBy=multi-user.target
