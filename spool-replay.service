[Unit]
Description=Spool Replay Plan (read-only; writes require explicit human approval)
Documentation=https://github.com/PowerStreamCoder/tradingbot-documentation
After=network-online.target
Wants=network-online.target
Requires=network-online.target

# Alert the operator if the replay job itself crashes (i.e. unhandled exception or
# bad path), distinct from the exit-1 we emit when individual records still fail.
# Per-record persistent failures are paged by the worker itself via notify_alert.py.
OnFailure=service-failure-notifier@%n.service

[Service]
Type=oneshot
User=i030983
Group=i030983

# Guard: abort early if the spool_replay module is not deployed yet.
ExecStartPre=/usr/bin/test -d /home/i030983/tradingbot-tools/spool_replay

WorkingDirectory=/home/i030983/tradingbot-tools

Environment=BOTS_DIR=/home/i030983/tradingbots
Environment=PYTHONPATH=/home/i030983/tradingbot-tools

# Refresh the exact, read-only replay plan for operator review. This unit MUST NOT
# write trades: approved replays are a separate, human-initiated VM command
# (`python -m spool_replay --approve <PLAN_ID> --actor NAME --reason TEXT`).
# Exit 1 means the planner itself crashed; pending records are informational.
ExecStart=/usr/bin/python3 -m spool_replay --dry-run --json

StandardOutput=journal
StandardError=journal
SyslogIdentifier=spool-replay

# Bounded: replay touches only the spool dir and Firestore; no heavy computation.
TimeoutStartSec=120s
MemoryMax=256M
CPUQuota=25%

# One-shot driven by the timer. The job is read-only; a failure is surfaced via
# OnFailure. No automatic retry and no implicit approval path.
Restart=no

[Install]
WantedBy=multi-user.target
